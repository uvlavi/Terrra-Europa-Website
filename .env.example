# Copy to .env and fill in real values before deploying

# Auth — team access key
ACCESS_KEY=28061972

# Sender identity
FROM_EMAIL=yuval@nova-terrra.eu
FROM_NAME=Yuval Lavi

# Mail is handled by Infomaniak kSuite (MX + kMail). The site sends exactly one
# kind of message: a lead notification to NOTIFY_EMAIL. It never mails a
# visitor-supplied address, so the form cannot be abused to spam strangers.
# Prefer an APPLICATION-SPECIFIC password here, not the main mailbox password.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=yuval@nova-terrra.eu
SMTP_PASS=
